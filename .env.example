# 10X RPC Backend — Environment Variables
# Fill in these values from your Vercel environment variables

# Database (Neon Postgres — same as Vercel frontend)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Discord credentials
DISCORD_CLIENT_ID="your_client_id"
DISCORD_CLIENT_SECRET="your_client_secret"
DISCORD_BOT_TOKEN="your_bot_token"
DISCORD_SERVER_ID="1549302358926823496"
DISCORD_INVITE_URL="https://discord.gg/jr27qeCZU"
DISCORD_OAUTH_SCOPE="openid identify sdk.social_layer_presence"
DISCORD_REDIRECT_URI="https://www.10xrpc.shop/auth/discord/callback"
DISCORD_GATEWAY_URL="wss://gateway.discord.gg/?v=10&encoding=json"

# Session secret (must match Vercel frontend)
SESSION_SECRET="your_session_secret"

# Frontend URL
NEXT_PUBLIC_APP_URL="https://www.10xrpc.shop"

# Backend API secret (set this on Vercel too as BACKEND_SECRET)
BACKEND_SECRET=""
