# ============================================================
# 10X RPC Backend Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# All values below are placeholders — replace with your real credentials.
# ============================================================

# --- Server ---
PORT=3000

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# --- Discord OAuth ---
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token

# OAuth redirect URI — MUST match Discord Developer Portal
# Format: https://your-backend-url/auth/callback
DISCORD_REDIRECT_URI=https://your-backend-url/auth/callback

# Discord Gateway
DISCORD_GATEWAY_URL=wss://gateway.discord.gg/?v=10&encoding=json

# Discord server
DISCORD_SERVER_ID=1549302358926823496
DISCORD_INVITE_URL=https://discord.gg/JjsPqbWnrH

# OAuth scopes
DISCORD_OAUTH_SCOPE=openid identify sdk.social_layer_presence

# --- Session ---
# Generate: openssl rand -hex 32
SESSION_SECRET=your_random_32_char_secret_here

# --- Frontend URL ---
NEXT_PUBLIC_APP_URL=https://www.10xrpc.shop
